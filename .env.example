# Copier ce fichier en .env et remplir les valeurs (ne jamais committer .env)

# --- Source : SQL Server local (authentification Windows) ---
MSSQL_HOST=localhost
MSSQL_DATABASE=WideWorldImporters
MSSQL_DRIVER=ODBC Driver 18 for SQL Server

# --- Destination : Snowflake ---
SNOWFLAKE_ACCOUNT=xxxxxxx-yyyyyyy
SNOWFLAKE_USER=WWI_PIPELINE_USER
SNOWFLAKE_PASSWORD=
SNOWFLAKE_ROLE=WWI_ENGINEER
SNOWFLAKE_WAREHOUSE=WWI_WH
SNOWFLAKE_DATABASE=WWI_DB

# --- Application Streamlit (facultatif : par défaut, même utilisateur avec le rôle WWI_ANALYST) ---
# SNOWFLAKE_APP_ROLE=WWI_ANALYST
# SNOWFLAKE_APP_USER=
# SNOWFLAKE_APP_PASSWORD=
